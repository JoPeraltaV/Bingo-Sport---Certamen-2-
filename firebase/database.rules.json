{
  "rules": {
    "salas": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('jugadores').child(auth.uid).exists() || newData.child('jugadores').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['codigo', 'anfitrionId', 'configuracion', 'jugadores', 'estado'])"
      }
    }
  }
}
